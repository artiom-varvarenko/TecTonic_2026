# Session signing key, at least 32 characters (e.g. `openssl rand -hex 32`).
TRUSTLABEL_SECRET_KEY=
# 1 = session cookie only over HTTPS; 0 for a plain-http local demo.
TRUSTLABEL_COOKIE_SECURE=1
# Per-user password hashes, created by `uv run python -m trustlabel.credentials`.
TRUSTLABEL_CREDENTIALS_FILE=.credentials.json
# Optional: enables "Answer by voice" (needs both keys) and chat capture.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
