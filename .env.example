# Session signing key, at least 32 characters (e.g. `openssl rand -hex 32`).
TRUSTLABEL_SECRET_KEY=
# 1 = session cookie only over HTTPS; 0 for a plain-http local demo.
TRUSTLABEL_COOKIE_SECURE=1
# Per-user password hashes, created by `uv run python -m trustlabel.credentials`.
TRUSTLABEL_CREDENTIALS_FILE=.credentials.json
# Optional: enables "Answer by voice" (needs both keys) and chat capture.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
# Voice for spoken chat answers (ElevenLabs text-to-speech); default: premade "Matilda".
ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX
# Optional: "Sign in with Google" (needs the client id, the secret and at least one mapping).
# Register <public URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email=user_id pairs; only these Google accounts can sign in, as that user.
TRUSTLABEL_GOOGLE_ACCOUNTS=
# Optional public base URL for redirect URIs (defaults to the request's base URL).
TRUSTLABEL_PUBLIC_URL=
# Optional: Spott (recruitment CRM). The API key writes verified answers back to the Spott client as a note.
SPOTT_API_KEY=
# Signing secret (whsec_…) of a Spott webhook for `note.created` at <public URL>/api/integrations/spott/webhook;
# with OPENAI_API_KEY, notes on Spott clients become graded sources.
SPOTT_WEBHOOK_SECRET=
# Optional: Salesforce Service Cloud (External Client App, client credentials flow); all three or none.
# My Domain host, e.g. orgfarm-xxxx-dev-ed.develop.my.salesforce.com
SALESFORCE_DOMAIN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# Optional: Teams expert alerts. Webhook URL of a Teams workflow (secret; https to *.logic.azure.com or *.api.powerplatform.com).
# TEAMS_WORKFLOW_URL=
# Comma-separated user_id=Teams sign-in address pairs; experts are @mentioned on the alert card.
# TRUSTLABEL_TEAMS_USERS=ellen=name@company.com
# Optional: Teams channel sync over Microsoft Graph (app-only; ChannelMessage.Read.All + User.Read.All, admin consent).
# MS_TENANT_ID, MS_CLIENT_ID and MS_CLIENT_SECRET together or none; channels as teamId/channelId pairs.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# TEAMS_SYNC_CHANNELS=00000000-0000-0000-0000-000000000000/19:abc@thread.tacv2
# Optional: meeting recordings folder (e.g. synced Teams recordings), scanned every 15 s; needs both AI keys.
# New mp3/m4a/wav/webm/ogg/mp4 files (max 25 MB) become meeting sources owned by TRUSTLABEL_MEETINGS_OWNER (a user id).
# TRUSTLABEL_MEETINGS_DIR=/path/to/Recordings
# TRUSTLABEL_MEETINGS_OWNER=ellen
# Optional: comma-separated user ids that may connect a Spott workspace on the Integrations page.
# TRUSTLABEL_ADMINS=lotte
# Optional: Claude drafts the question sent to the expert (otherwise a fixed template). Model defaults to claude-haiku-5-5.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
